# Secrets and local state never ship.
.env
.env.*
*.pem
*.key

# A plugin's own runtime state / config seeds that hold live values.
# Ship `config.json.example` instead — dummy values only.
plugins/*/config.json
plugins/*/library.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Scratch clone used by scripts/open_catalog_pr.sh — never committed.
.catalog-work/

# Test build output: certificates generated relative to NOW, and the synthetic trees the
# harnesses audit. Regenerating tracked certificates rewrote them on every test run, so the
# suite dirtied the working tree (and `open_catalog_pr.sh` refuses to run on a dirty tree).
# The only certificates tracked are the two pinned to fixed dates — exp3/fut — which cannot
# be generated relative to today.
tests/.build/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp